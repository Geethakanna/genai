# END USERS DO NOT NEED THIS FILE. Everything here is optional.
#
# Google sign-in uses an OAuth client that YOU (the developer) put in
# src/guardianai/data/google_client.json once, before shipping. Paste the JSON
# Google Cloud Console gives you for an OAuth client of type "Desktop app".
# For quick local development you can instead set:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

GUARDIANAI_HOST=127.0.0.1
GUARDIANAI_PORT=8765
# GUARDIANAI_HOME=~/.guardianai
